# ─────────────────────────────────────────────────────────────────────────────
# MAREFIYAYE — Root Environment Reference (NOT loaded by apps)
# Path: marefiyaye/.env.example
# Purpose: Documents every env var used by apps/api and apps/web.
#          Copy the matching per-app .env.example into .env.local inside
#          apps/api and apps/web before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development

# ── API Server ──
API_PORT=5000
API_ORIGIN=http://localhost:5000
WEB_ORIGIN=http://localhost:3000

# ── Database (Neon PostgreSQL) ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ── JWT ──
JWT_ACCESS_SECRET=replace_with_strong_random_32_chars
JWT_REFRESH_SECRET=replace_with_strong_random_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=marefiyaye

# ── Cookie ──
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ── Admin Bootstrap (used by seed.js) ──
ADMIN_EMAIL=admin@marefiyaye.com
ADMIN_PASSWORD=ChangeMeStrong123!
ADMIN_FULL_NAME=Marefiyaye Admin
ADMIN_PHONE=+251900000000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=marefiyaye
CLOUDINARY_UPLOAD_PRESET=unsigned

# ── Uploads ──
UPLOAD_MAX_FILE_SIZE_MB=5

# ── Logging ──
LOG_LEVEL=info

# ── Frontend (exposed to browser) ──
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_NAME=MAREFIYAYE
NEXT_PUBLIC_APP_NAME_AM=ማረፊያዬ
NEXT_PUBLIC_DEFAULT_LANG=en
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name