# ─────────────────────────────────────────────────────────────────────────────
# MAREFIYAYE API — Environment Configuration Example
# Path: apps/api/.env.example
#
# Purpose:
#   Reference template for all environment variables required by the API.
#   Copy this file to `.env` locally and fill in real values.
#   In production (Vercel), set these in the Project Settings → Environment
#   Variables UI instead. Never commit real secrets to source control.
#
# Conventions:
#   - One variable per line, `KEY=value` with no spaces around `=`.
#   - Secrets must be continuous single-line strings (no line wrapping).
#   - Production overrides (NODE_ENV, COOKIE_SECURE) are noted per section.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# Override to "production" in Vercel.
NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────────────
# Vercel ignores API_PORT (serverless), but local dev needs it.
API_PORT=5000
API_ORIGIN=http://localhost:5000
WEB_ORIGIN=http://localhost:3000

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Use `sslmode=verify-full` for strict TLS certificate validation.
# Rotate the database password immediately if this value leaks.
DATABASE_URL=postgresql://neondb_owner:npg_Tc7is8JDbILj@ep-autumn-unit-b9kenk31-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Each secret must be a single continuous string of 64 hex characters.
JWT_ACCESS_SECRET=a9e2d512721506f305b87906bbede6851858afc103f9dba9ede6088732
a1f32a
JWT_REFRESH_SECRET=75a9ed9e8c12db74091a3f34ffa68835b46559f7b64c4c2475ec414bce
591cc4
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=marefiyaye

# ── Cookie ───────────────────────────────────────────────────────────────────
# Local dev: COOKIE_SECURE=false (HTTP localhost).
# Vercel prod: COOKIE_SECURE=true (HTTPS only — required for auth cookies).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ── Admin Bootstrap ──────────────────────────────────────────────────────────
# Seeded on first migration. Change these before the first production deploy.
ADMIN_EMAIL=admin@marefiyaye.com
ADMIN_PASSWORD=ChangeMeStrong123!
ADMIN_FULL_NAME=Marefiyaye Admin
ADMIN_PHONE=+251900000000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Retrieve from Cloudinary Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=dwu1urppe
CLOUDINARY_API_KEY=933927224476837
CLOUDINARY_API_SECRET=mExr6aJpTheeSEbCJbOpmhtdoq0
CLOUDINARY_FOLDER=marefiyaye
CLOUDINARY_UPLOAD_PRESET=unsigned

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=7

# ── Logging ──────────────────────────────────────────────────────────────────
# Use "info" in production; "debug" in local dev.
LOG_LEVEL=info