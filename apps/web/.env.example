# ============================================================================
# apps/web/.env.example
#
# Template for apps/web environment variables.
#
# Local dev:   copy to apps/web/.env.local and fill in real values
# Production:  paste these into Vercel dashboard → marefiyaye-web → Settings → Env Vars
#
# IMPORTANT: NEVER commit apps/web/.env.local.
# ============================================================================

# Base URL of the Express API.
#   Dev:  http://localhost:4000
#   Prod: https://marefiyaye-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Brand identity (used by the i18n config and page metadata).
NEXT_PUBLIC_APP_NAME=Marefiyaye
NEXT_PUBLIC_APP_NAME_AM=ማረፊያዬ

# Public site URL — used for OG tags and canonical links.
#   Dev:  http://localhost:3000
#   Prod: https://marefiyaye.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default locale (en | am). Users can override via the locale switcher.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Default currency (ETB | USD). Users can override via the currency switcher.
NEXT_PUBLIC_DEFAULT_CURRENCY=ETB

# Admin JWT secret — MUST match apps/api/.env.local ADMIN_JWT_SECRET.
# Used by the web-side middleware to verify the admin_token cookie on the edge.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_same_value_as_api_admin_jwt_secret