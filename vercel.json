{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@marefiyaye/web",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "regions": ["fra1"],
  "functions": {
    "apps/web/src/app/api/v1/[...path]/route.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}