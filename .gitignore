# ─────────────────────────────────────────────────────────────────────────────
# MAREFIYAYE — Git Ignore Rules
# Path: marefiyaye/.gitignore
# Purpose: Excludes dependencies, builds, env files, logs and editor artifacts.
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment (keep .env.example tracked)
.env
.env.local
.env.*.local
!.env.example

# Next.js
.next/
out/
next-env.d.ts

# Build artifacts
build/
dist/
*.tsbuildinfo

# Vercel
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts (keep recommended extensions)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Testing & coverage
coverage/
.nyc_output/

# Local misc
*.local
.cache/
.tmp/